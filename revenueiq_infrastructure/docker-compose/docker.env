# Development Mode (dev | prod)
MODE=prod

# Stack configuration
STACK_NAME=prod
IMAGE_TAG=latest
OWNER=revenueiq
AWS_S3_BUCKET="revenueiq-storage"
RAZORPAY_KEY_ID="rzp_test_SESIqmsJZRvpZ1"
RAZORPAY_KEY_SECRET="4qzbtZYU4wrF4ER3lYk2hIt7"

# Docker path resolution (used by docker-compose)
PROJECT_ROOT=../../
ENVOY_PATH=../envoy

# Gateway Service Ports
GATEWAY_SERVICE_PORT=8080
GATEWAY_HTTPS_SERVICE_PORT=8443

# Service gRPC Ports
AUTH_SERVICE_PORT=50053
MONGODB_SERVICE_PORT=50051
REDIS_SERVICE_PORT=50052
QUEUE_SERVICE_PORT=50054
S3_SERVICE_PORT=50055
ORDER_SERVICE_PORT=50056
FLEET_SERVICE_PORT=50057
FLIGHT_SERVICE_PORT=50058
TELEMETRY_SERVICE_PORT=50059
OPERATIONS_SERVICE_PORT=50060
WAREHOUSE_SERVICE_PORT=50061
DELIVERY_SERVICE_PORT=50062
PAYMENT_SERVICE_PORT=50063
ANALYTICS_SERVICE_PORT=50064
MONITORING_SERVICE_PORT=50065

# Service HTTP Ports
AUTH_SERVICE_HTTP_PORT=8081
NOTIFICATION_HEALTH_PORT=8083
ORDER_SERVICE_HTTP_PORT=8086
FLEET_SERVICE_HTTP_PORT=8087
FLIGHT_SERVICE_HTTP_PORT=8088
TELEMETRY_SERVICE_HTTP_PORT=8089
OPERATIONS_SERVICE_HTTP_PORT=8090
WAREHOUSE_SERVICE_HTTP_PORT=8091
DELIVERY_SERVICE_HTTP_PORT=8092
PAYMENT_SERVICE_HTTP_PORT=8093
ANALYTICS_SERVICE_HTTP_PORT=8094

# Database Host Ports (exposed to host from containers in dev)
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379

# Queue & Redpanda Host Ports
REDPANDA_HOST_PORT=9092
REDPANDA_CONSOLE_PORT=8082

# HashiCorp Vault Configuration
VAULT_HOST_PORT=8200
VAULT_TOKEN="my-root-token"

# Database Configuration (Docker container network)
MONGO_URI="mongodb://mongodb:27017"
MONGO_DB="mongodb_service_db"
MONGO_COLLECTION="users"
REDIS_ADDR="redis:6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Redpanda Configuration (Within Docker backend network)
REDPANDA_ADDR="redpanda:29092"

# Service gRPC Addresses (Within Docker backend network)
MONGO_SERVICE_ADDR="mongodb-service:50051"
REDIS_SERVICE_ADDR="redis-service:50052"
QUEUE_SERVICE_ADDR="queue-service:50054"
S3_SERVICE_ADDR="s3-service:50055"
ORDER_SERVICE_ADDR="order-service:50056"
FLEET_SERVICE_ADDR="fleet-service:50057"
FLIGHT_SERVICE_ADDR="flight-service:50058"
TELEMETRY_SERVICE_ADDR="telemetry-service:50059"
OPERATIONS_SERVICE_ADDR="operations-service:50060"
WAREHOUSE_SERVICE_ADDR="warehouse-service:50061"
DELIVERY_SERVICE_ADDR="delivery-service:50062"
PAYMENT_SERVICE_ADDR="payment-service:50063"
ANALYTICS_SERVICE_ADDR="analytics-service:50064"
MONITORING_SERVICE_ADDR="monitoring-service:50065"

# JWT Settings
JWT_SECRET="super-secret-jwt-key-change-this-in-production"

# Rate Limiter Settings
RATE_LIMIT_REQUESTS_PER_SECOND=50
RATE_LIMIT_WINDOW_SECONDS=1

# CORS Settings
CORS_ALLOWED_ORIGINS="*"

# AWS Settings (used for SES and S3)
AWS_SES_MOCK=true
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# S3 Service Configuration
AWS_S3_ENDPOINT=""
AWS_S3_BUCKET="revenueiq-storage"
AWS_S3_FORCE_PATH_STYLE=false

# Payment Service Configuration (Razorpay)
RAZORPAY_KEY_ID="rzp_test_SESIqmsJZRvpZ1"
RAZORPAY_KEY_SECRET="4qzbtZYU4wrF4ER3lYk2hIt7"
