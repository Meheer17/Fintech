# ==========================================
# Fintech Monorepo .gitignore
# Covers Go, Python, Node.js/Frontend, Infrastructure, IDEs, and Secrets
# ==========================================

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
credentials.json

# ------------------------------------------
# Binaries & Executables
# ------------------------------------------
server
bin/
*.exe
*.dll
*.so
*.dylib

# ------------------------------------------
# Go Language
# ------------------------------------------
*.test
*.out
*.coverprofile
coverage.txt
coverage.html
vendor/
go.work.local

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/
env/
.env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Testing & Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------
# Node.js & Frontend
# ------------------------------------------
node_modules/
.next/
.nuxt/
.vuepress/
.npm/
.yarn/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ------------------------------------------
# Infrastructure & Terraform
# ------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ------------------------------------------
# Database & Local Data
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.ldf
*.mdf

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# IDEs & OS Specific Files
# ------------------------------------------
.vscode/
.idea/
*.iml
*.iws
*.ipr
.zed/
.project
.classpath
.settings/

# OS Generated
.DS_Store
.DS_Store?
._*
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
